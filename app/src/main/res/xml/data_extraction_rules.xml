<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ backup rules. Journal data is sensitive and stays out of Google cloud backups.
   Direct device-to-device transfer (e.g. setting up a new phone with a cable or Wi-Fi) is allowed
   so people can keep their journal when they switch phones.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
