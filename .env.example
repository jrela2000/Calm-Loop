# AI_PROXY_URL: HTTPS address of the CalmLoop AI relay (see proxy/README.md), e.g.
#   AI_PROXY_URL=https://calmloop-ai.<your-subdomain>.workers.dev
# Copy this file to .env and fill it in. Leave it empty to build with AI reflections disabled;
# everything else in the app works offline. Never put an AI provider key in the app.
AI_PROXY_URL=
