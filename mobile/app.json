{
  "expo": {
    "name": "CalmLoop",
    "slug": "calmloop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "calmloop",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F2F6FC",
    "ios": {
      "bundleIdentifier": "com.jarrodqsimpson.calmloop",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jarrodqsimpson.calmloop",
      "adaptiveIcon": {
        "backgroundColor": "#F8F0E5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "allowBackup": false,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "CalmLoop",
      "shortName": "CalmLoop",
      "themeColor": "#639BD3",
      "backgroundColor": "#F2F6FC"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F8F0E5",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0E1526"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "CalmLoop uses the microphone so you can speak your journal entries instead of typing. Audio is not recorded or saved.",
          "speechRecognitionPermission": "CalmLoop uses speech recognition to turn your spoken journal entries into text. Audio is not recorded or saved.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-sharing",
      "expo-document-picker",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
